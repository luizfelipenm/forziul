# Supabase — encontre em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada nos callbacks do Mercado Pago)
# Em dev: http://localhost:3000 — em produção: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago — encontre em developers.mercadopago.com > Suas integrações
MERCADO_PAGO_ACCESS_TOKEN=

# CJ Dropshipping — encontre no painel de API da sua conta CJ
CJ_DROPSHIPPING_API_KEY=

# Z-API — notificação automática no seu WhatsApp
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_NOTIFICATION_PHONE=5561999999999
